{
  "mcpServers": {
    "code-review-graph": {
      "command": "code-review-graph",
      "args": [
        "serve",
        "--repo",
        "."
      ]
    },
    "stitch": {
      "command": "bash",
      "args": [
        "./scripts/stitch-proxy.sh"
      ]
    },
    "magic": {
      "command": "bash",
      "args": [
        "./scripts/magic-mcp.sh"
      ]
    },
    "google-analytics": {
      "command": "pipx",
      "args": [
        "run",
        "analytics-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}"
      }
    }
  }
}
